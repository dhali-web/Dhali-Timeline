{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dhali-timeline/dh-timeline",
	"version": "0.1.0",
	"title": "Dhali Timeline",
	"category": "widgets",
	"icon": "smiley",
	"description": "Dhali block to make a timeline with columns.",
	"example": {},
	"attributes": {
		"lineThickness": { "type": "number", "default": 8 },
		"markerSize": { "type": "number", "default": 20 },
		"activeLineColor": { "type": "string" },
		"inactiveLineColor": { "type": "string" },
		"activeMarkerColor": { "type": "string" },
		"inactiveMarkerColor": { "type": "string" }
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"textdomain": "dhali-timeline",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js",
	"allowedBlocks": ["core/group"]
}
